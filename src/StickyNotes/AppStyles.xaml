<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <BitmapImage x:Key="AppIcon" UriSource="Assets/StickyNotes.ico"/>
  <DataTemplate x:Key="WrappingButtonContent"><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
  <Style TargetType="Button">
    <Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="2"/>
    <Setter Property="Background" Value="#DFEDF9"/><Setter Property="BorderBrush" Value="#8CAFCF"/>
    <Setter Property="Foreground" Value="#173D60"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3,0,9"/></Style>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Yu Gothic UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Icon" Value="{StaticResource AppIcon}"/></Style>
</ResourceDictionary>
